generator client {
  provider   = "prisma-client-js"
  output     = "../generated/prisma"
  engineType = "library"
}

datasource db {
  provider = "postgresql"
  url = env("DATABASE_URL")
}

enum Classification {
  PROJECT
  FEATURE
  BUG
  REFACTOR
  RESEARCH_SPIKE
}

enum Status {
  TODO
  IN_PROGRESS
  DONE
  INCUBATOR
  ACTIVE
}

model User {
  id            String        @id @unique
  name          String
  email         String        @unique

  hasNotifications Boolean @default(false)

  createdAt DateTime  @default(now())
  
  // Notifications
  notifications          Notification[]        @relation("UserNotifications")

  @@index([name])
  @@index([email])
}

model Notification {
  id     String @id @unique @default(uuid()) @db.Uuid
  userId String

  title   String
  message String?
  url     String?

  user User @relation("UserNotifications", fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

model BrainDump {
  id            String    @id @default(uuid()) @db.Uuid
  userId        String    @map("user_id") @db.Uuid
  rawTranscript String    @map("raw_transcript")
  processedAt   DateTime? @map("processed_at")
  createdAt     DateTime  @default(now()) @map("created_at")

  projects      Project[]

  @@map("brain_dumps")
}

model Project {
  id             String         @id @default(uuid()) @db.Uuid
  userId         String         @map("user_id") @db.Uuid
  originDumpId   String?        @map("origin_dump_id") @db.Uuid
  title          String         @db.VarChar(255)
  description    String?        @db.Text
  classification Classification
  status         Status         @default(INCUBATOR)

  techStack      String[]       @map("tech_stack")
  createdAt      DateTime       @default(now()) @map("created_at")

  originDump     BrainDump?     @relation(fields: [originDumpId], references: [id])
  tasks          Task[]
  resources      Resource[]

  @@map("projects")
}

model Task {
  id        String   @id @default(uuid()) @db.Uuid
  projectId String   @map("project_id") @db.Uuid
  title     String   @db.VarChar(255)
  status    Status   @default(TODO)
  createdAt DateTime @default(now()) @map("created_at")

  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@map("tasks")
}

model Resource {
  id        String   @id @default(uuid()) @db.Uuid
  projectId String   @map("project_id") @db.Uuid
  title     String   @db.VarChar(255)
  url       String   @db.Text
  type      String?  @db.VarChar(50)
  summary   String?  @db.Text
  createdAt DateTime @default(now()) @map("created_at")

  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@map("resources")
}