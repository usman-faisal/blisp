generator client {
  provider   = "prisma-client-js"
  output     = "../generated/prisma"
  engineType = "library"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Classification {
  PROJECT
  FEATURE
  BUG
  REFACTOR
  RESEARCH_SPIKE
  PROGRESS_UPDATE
}

enum ProjectStatus {
  INCUBATOR
  ACTIVE
  ARCHIVED
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  DONE
}

enum BrainDumpStatus {
  PENDING
  PROCESSED
  FAILED
}

model User {
  id               String         @id @unique
  name             String
  email            String         @unique
  hasNotifications Boolean        @default(false)
  createdAt        DateTime       @default(now())

  // Notifications
  notifications    Notification[] @relation("UserNotifications")
  brainDumps       BrainDump[]
  projects         Project[]
  dailyPlans       DailyPlan[]

  @@index([name])
  @@index([email])
}

model Notification {
  id        String   @id @unique @default(uuid()) @db.Uuid
  userId    String   @db.Text
  title     String
  message   String?
  url       String?
  user      User     @relation("UserNotifications", fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

model BrainDump {
  id            String           @id @default(uuid()) @db.Uuid
  userId        String           @map("user_id")
  rawTranscript String           @map("raw_transcript")
  status        BrainDumpStatus  @default(PENDING)
  processedAt   DateTime?        @map("processed_at")
  createdAt     DateTime         @default(now()) @map("created_at")
  
  user          User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  projects      Project[]

  @@map("brain_dumps")
}

model Project {
  id             String         @id @default(uuid()) @db.Uuid
  userId         String         @map("user_id")
  originDumpId   String?        @map("origin_dump_id") @db.Uuid
  title          String         @db.VarChar(255)
  description    String?        @db.Text
  classification Classification
  status         ProjectStatus  @default(INCUBATOR)

  techStack      String[]       @map("tech_stack")
  createdAt      DateTime       @default(now()) @map("created_at")

  originDump     BrainDump?     @relation(fields: [originDumpId], references: [id])
  tasks          Task[]
  resources      Resource[]
  user           User           @relation(fields: [userId], references: [id])

  @@map("projects")
}

model Task {
  id                  String      @id @default(uuid()) @db.Uuid
  projectId           String      @map("project_id") @db.Uuid
  dailyPlanId         String?     @map("daily_plan_id") @db.Uuid
  title               String      @db.VarChar(255)
  status              TaskStatus  @default(TODO)
  isImmediateNextStep Boolean     @default(false) @map("is_immediate_next_step")
  createdAt           DateTime    @default(now()) @map("created_at")
  plannedFor          DateTime?   @db.Date

  project     Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  dailyPlan   DailyPlan?  @relation(fields: [dailyPlanId], references: [id])
  resources   Resource[]

  @@map("tasks")
}

model Resource {
  id        String   @id @default(uuid()) @db.Uuid
  projectId String   @map("project_id") @db.Uuid
  taskId    String?  @map("task_id") @db.Uuid
  title     String   @db.VarChar(255)
  url       String   @db.Text
  type      String?  @db.VarChar(50)
  summary   String?  @db.Text
  createdAt DateTime @default(now()) @map("created_at")

  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  task      Task?    @relation(fields: [taskId], references: [id], onDelete: SetNull)

  @@map("resources")
}

model DailyPlan {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Text
  planDate  DateTime @map("plan_date") @db.Date
  tasks     Task[]
  summary   String?  @db.Text
  createdAt DateTime @default(now()) @map("created_at")
  
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, planDate])
  @@map("daily_plans")
}