generator client {
  provider   = "prisma-client-js"
  output     = "../generated/prisma"
  engineType = "library"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Classification {
  PROJECT
  FEATURE
  BUG
  REFACTOR
  RESEARCH_SPIKE
}

enum ProjectStatus {
  INCUBATOR
  ACTIVE
  ARCHIVED
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  DONE
}

enum BrainDumpStatus {
  PENDING
  PROCESSED
  FAILED
}

enum PipelineStage {
  RESEARCH_STARTED
  RESEARCH_COMPLETED
  PLAN_STARTED
  PLAN_COMPLETED
  DAILY_PLAN_STARTED
  DAILY_PLAN_COMPLETED
  RESOURCE_FETCH_STARTED
  RESOURCE_FETCH_COMPLETED
}

enum ProjectRole {
  OWNER
  MEMBER
}

model User {
  id               String         @id @unique
  name             String
  email            String         @unique
  hasNotifications Boolean        @default(false)
  createdAt        DateTime       @default(now())

  notifications    Notification[] @relation("UserNotifications")
  brainDumps       BrainDump[]
  projects         Project[]
  dailyPlans       DailyPlan[]

  projectMembers   ProjectMember[]

  @@index([name])
  @@index([email])
}

model Notification {
  id        String   @id @unique @default(uuid()) @db.Uuid
  userId    String   @db.Text
  title     String
  message   String?
  url       String?
  user      User     @relation("UserNotifications", fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

model BrainDump {
  id            String          @id @default(uuid()) @db.Uuid
  userId        String          @map("user_id")
  rawTranscript String          @map("raw_transcript")
  status        BrainDumpStatus @default(PENDING)
  processedAt   DateTime?       @map("processed_at")
  createdAt     DateTime        @default(now()) @map("created_at")

  user          User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  projects      Project[]

  @@map("brain_dumps")
}

model Project {
  id             String         @id @default(uuid()) @db.Uuid
  userId         String         @map("user_id")
  originDumpId   String?        @map("origin_dump_id") @db.Uuid
  title          String         @db.VarChar(255)
  description    String?        @db.Text
  classification Classification
  status         ProjectStatus  @default(INCUBATOR)
  techStack      String[]       @map("tech_stack")
  createdAt      DateTime       @default(now()) @map("created_at")

  originDump     BrainDump?     @relation(fields: [originDumpId], references: [id])
  tasks          Task[]
  resources      Resource[]
  pipelineEvents ProjectEvent[]
  user           User           @relation(fields: [userId], references: [id])

  // userId above stays the creator: brain dumps, research jobs and pipeline
  // events are all per-user. Membership governs access; userId governs origin.
  members        ProjectMember[]
  invites        ProjectInvite[]

  @@map("projects")
}

model ProjectMember {
  id        String      @id @default(uuid()) @db.Uuid
  projectId String      @map("project_id") @db.Uuid
  userId    String      @map("user_id")
  role      ProjectRole @default(MEMBER)
  joinedAt  DateTime    @default(now()) @map("joined_at")

  project   Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([projectId, userId])
  @@index([userId])
  @@map("project_members")
}

model ProjectInvite {
  id        String    @id @default(uuid()) @db.Uuid
  projectId String    @map("project_id") @db.Uuid
  code      String    @unique @db.VarChar(12)
  createdBy String    @map("created_by")
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  usedBy    String?   @map("used_by")
  createdAt DateTime  @default(now()) @map("created_at")

  project   Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@map("project_invites")
}

model Task {
  id              String     @id @default(uuid()) @db.Uuid
  projectId       String     @map("project_id") @db.Uuid
  dailyPlanId     String?    @map("daily_plan_id") @db.Uuid
  title           String     @db.VarChar(255)
  status          TaskStatus @default(TODO)
  resourceQueries String[]   @map("resource_queries")
  rolloverCount   Int        @default(0) @map("rollover_count")
  createdAt       DateTime   @default(now()) @map("created_at")
  plannedFor      DateTime?  @db.Date

  project         Project    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  dailyPlan       DailyPlan? @relation(fields: [dailyPlanId], references: [id])
  resources       Resource[]

  @@map("tasks")
}

model Resource {
  id        String   @id @default(uuid()) @db.Uuid
  projectId String   @map("project_id") @db.Uuid
  taskId    String?  @map("task_id") @db.Uuid
  title     String   @db.VarChar(255)
  url       String   @db.Text
  type      String?  @db.VarChar(50)
  summary   String?  @db.Text
  createdAt DateTime @default(now()) @map("created_at")

  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  task      Task?    @relation(fields: [taskId], references: [id], onDelete: SetNull)

  @@map("resources")
}

model ProjectEvent {
  id        String        @id @default(uuid()) @db.Uuid
  projectId String        @map("project_id") @db.Uuid
  stage     PipelineStage
  message   String?       @db.Text
  createdAt DateTime      @default(now()) @map("created_at")

  project   Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@map("project_events")
}

model DailyPlan {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Text
  planDate  DateTime @map("plan_date") @db.Date
  summary   String?  @db.Text
  createdAt DateTime @default(now()) @map("created_at")

  tasks     Task[]
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, planDate])
  @@map("daily_plans")
}