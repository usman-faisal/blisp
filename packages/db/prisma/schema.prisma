generator client {
  provider   = "prisma-client-js"
  output     = "../generated/prisma"
  engineType = "library"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Classification {
  PROJECT
  FEATURE
  BUG
  REFACTOR
  RESEARCH_SPIKE
}

enum ProjectStatus {
  INCUBATOR
  ACTIVE
  ARCHIVED
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  DONE
  /// Dropped from scope. Excluded from completion percentages entirely rather
  /// than counted as incomplete — otherwise cancelling work makes a project
  /// look like it is falling behind, which the plan explicitly forbids.
  CANCELLED
  /// Pushed out of the current plan but still intended. Also excluded from
  /// percentages, and distinct from CANCELLED so the user can tell "later"
  /// from "never".
  DEFERRED
}

/// Rough effort, used to weight progress.
///
/// A coarse scale rather than hour estimates: a beginner cannot estimate hours
/// reliably, and false precision would make the roadmap look authoritative when
/// it is not. Points are assigned in TASK_EFFORT_POINTS.
enum TaskEffort {
  SMALL
  MEDIUM
  LARGE
}

enum TaskPriority {
  MUST_HAVE
  SHOULD_HAVE
  LATER
}

/// Self-reported experience, used to pad estimates rather than to gate features.
enum SkillLevel {
  BEGINNER
  INTERMEDIATE
  ADVANCED
}

enum MilestoneStatus {
  PLANNED
  IN_PROGRESS
  DONE
  /// Excluded from progress for the same reason as a cancelled task.
  CANCELLED
}

enum BrainDumpStatus {
  PENDING
  PROCESSED
  FAILED
}

enum PipelineStage {
  RESEARCH_STARTED
  RESEARCH_COMPLETED
  PLAN_STARTED
  PLAN_COMPLETED
  DAILY_PLAN_STARTED
  DAILY_PLAN_COMPLETED
  RESOURCE_FETCH_STARTED
  RESOURCE_FETCH_COMPLETED
  // Discovery report — distinct from RESEARCH_*, which covers the fast
  // documentation pass that feeds task planning.
  DISCOVERY_REPORT_STARTED
  DISCOVERY_REPORT_COMPLETED
  DISCOVERY_REPORT_FAILED
}

enum ResearchReportStatus {
  /// Generation queued or in flight; sections not yet written.
  PENDING
  /// Generated and readable, but the user has not accepted it.
  DRAFT
  /// User accepted this version. Regeneration must not overwrite it.
  APPROVED
  /// User read this version and turned it down. Distinct from DRAFT, which
  /// means "not yet judged": without this, a report the user disagreed with is
  /// indistinguishable from one they never opened. Kept readable, with
  /// `rejectionReason` explaining why, so the next version can address it.
  REJECTED
  /// Generation failed; `error` explains why. Kept so the UI can show it.
  FAILED
  /// The user stopped generation before it finished. Distinct from FAILED,
  /// which means the pipeline broke: nothing went wrong here, so the UI should
  /// not offer an error or apologise. The row is kept rather than deleted so
  /// the version history records the attempt.
  CANCELLED
}

enum ProjectRole {
  OWNER
  MEMBER
}

// Lifecycle of a targeted invite. The code flow has no use for it and stays
// PENDING until claimed, where `usedAt` remains the authority.
//
// DECLINED is kept distinct from REVOKED so the inviter can tell "they said no"
// from "I withdrew it" — and from an invite that simply expired unanswered.
enum InviteStatus {
  PENDING
  ACCEPTED
  DECLINED
  REVOKED
}

// Discriminates a notification's kind so the client can render and act on it.
// Before this existed, kind was only recoverable by string-matching the literal
// title the listener wrote — fine for display, useless for behaviour.
// GENERIC is the default so pre-existing rows migrate without a backfill.
enum NotificationType {
  GENERIC
  MEMBER_JOINED
  TASK_ASSIGNED
  TASK_COMMENTED
  TASK_MENTIONED
  TASK_COMPLETED
  PROJECT_INVITE
}

model User {
  id               String   @id @unique
  name             String
  email            String   @unique
  hasNotifications Boolean  @default(false)
  createdAt        DateTime @default(now())

  notifications Notification[] @relation("UserNotifications")
  brainDumps    BrainDump[]
  projects      Project[]
  dailyPlans    DailyPlan[]

  projectMembers  ProjectMember[]
  invitesCreated  ProjectInvite[] @relation("InviteCreator")
  invitesAccepted ProjectInvite[] @relation("InviteJoiner")
  invitesReceived ProjectInvite[] @relation("InviteRecipient")
  assignedTasks   Task[]          @relation("TaskAssignee")
  taskComments    TaskComment[]

  /// GitHub login, captured when the user links a repository or signs in with
  /// GitHub. This is what lets a commit author be matched to a BLISP user, so
  /// evidence can be attributed in a team project.
  githubLogin String? @map("github_login") @db.VarChar(100)

  linkedRepositories ProjectRepository[]
  evidenceAdded      TaskEvidence[]

  @@index([name])
  @@index([email])
}

model Notification {
  id        String           @id @unique @default(uuid()) @db.Uuid
  userId    String           @db.Text
  title     String
  message   String?
  url       String?
  type      NotificationType @default(GENERIC)
  user      User             @relation("UserNotifications", fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  // Nullable timestamp rather than a `read` boolean: same storage, and it
  // answers "when" for free. Null means unread, so existing rows need no
  // backfill — they are correctly unread on arrival.
  readAt DateTime? @map("read_at")

  // A typed FK, not a generic entityId/entityType pair, specifically to get
  // this cascade: revoking an invite removes the notification carrying its
  // accept/decline buttons. A string column could not, and would leave a row
  // whose action 404s.
  inviteId String?        @map("invite_id") @db.Uuid
  invite   ProjectInvite? @relation(fields: [inviteId], references: [id], onDelete: Cascade)

  @@index([userId])
  // Drives the unread count, which is read on every notification-list load.
  @@index([userId, readAt])
}

model BrainDump {
  id            String          @id @default(uuid()) @db.Uuid
  userId        String          @map("user_id")
  rawTranscript String          @map("raw_transcript")
  status        BrainDumpStatus @default(PENDING)
  processedAt   DateTime?       @map("processed_at")
  createdAt     DateTime        @default(now()) @map("created_at")

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  projects Project[]

  @@map("brain_dumps")
}

model Project {
  id             String         @id @default(uuid()) @db.Uuid
  userId         String         @map("user_id")
  originDumpId   String?        @map("origin_dump_id") @db.Uuid
  title          String         @db.VarChar(255)
  description    String?        @db.Text
  classification Classification
  status         ProjectStatus  @default(INCUBATOR)
  techStack      String[]       @map("tech_stack")
  createdAt      DateTime       @default(now()) @map("created_at")

  originDump     BrainDump?     @relation(fields: [originDumpId], references: [id])
  tasks          Task[]
  resources      Resource[]
  pipelineEvents ProjectEvent[]
  user           User           @relation(fields: [userId], references: [id])

  // userId above stays the creator: brain dumps, research jobs and pipeline
  // events are all per-user. Membership governs access; userId governs origin.
  members ProjectMember[]
  invites ProjectInvite[]

  researchReports ResearchReport[]
  milestones      Milestone[]
  /// Linked GitHub repositories, read-only, used as evidence for completion.
  repositories    ProjectRepository[]

  /// Roadmap planning inputs, captured once per project rather than on the
  /// user: someone may have a tight deadline on one project and none on
  /// another. All optional — a project without them simply has no roadmap yet.
  deadline         DateTime?   @db.Date
  /// Hours the user expects to work on this project on a working day.
  hoursPerDay      Float?      @map("hours_per_day")
  /// ISO weekdays the user works, 1 = Monday .. 7 = Sunday. Empty means unset.
  workingDays      Int[]       @map("working_days")
  skillLevel       SkillLevel? @map("skill_level")
  /// When the roadmap was last generated, so the UI can offer to refresh it.
  roadmapPlannedAt DateTime?   @map("roadmap_planned_at")

  @@map("projects")
}

model ProjectMember {
  id        String      @id @default(uuid()) @db.Uuid
  projectId String      @map("project_id") @db.Uuid
  userId    String      @map("user_id")
  role      ProjectRole @default(MEMBER)
  joinedAt  DateTime    @default(now()) @map("joined_at")

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([projectId, userId])
  @@index([userId])
  @@map("project_members")
}

model ProjectInvite {
  id        String @id @default(uuid()) @db.Uuid
  projectId String @map("project_id") @db.Uuid

  // Nullable since targeted invites carry no code: minting one anyway would
  // create a second, unintended way into the project. Postgres permits many
  // NULLs under a UNIQUE constraint, so no partial index is needed.
  code String? @unique @db.VarChar(12)

  createdBy String    @map("created_by")
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  usedBy    String?   @map("used_by")
  createdAt DateTime  @default(now()) @map("created_at")

  // Targeted-invite fields. invitedUserId null = an open code invite.
  //
  // usedAt/usedBy overlap with status/respondedAt for targeted invites, and are
  // set alongside them on accept. Unifying the two is deliberately not attempted
  // here: the code flow is working and tested, and rewriting it would double the
  // blast radius of this change.
  status        InviteStatus @default(PENDING)
  invitedUserId String?      @map("invited_user_id")
  respondedAt   DateTime?    @map("responded_at")

  // Names captured at invite time. Denormalised on purpose: the relations below
  // give the current name, but these make an invite row readable on its own
  // (Studio, logs, SQL) without a join, and preserve who-was-who historically.
  // A later rename does not rewrite them — that is the intent, not a defect.
  createdByName String  @map("created_by_name")
  usedByName    String? @map("used_by_name")

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  // Relations so who-invited-whom is readable by joining rather than by
  // eyeballing Clerk ids. Names stay current: no snapshot to go stale.
  // Cascade on the creator (their invites are meaningless without them);
  // SetNull on the joiner so the invite's audit trail survives their removal.
  creator User  @relation("InviteCreator", fields: [createdBy], references: [id], onDelete: Cascade)
  joiner  User? @relation("InviteJoiner", fields: [usedBy], references: [id], onDelete: SetNull)

  // The person a targeted invite is addressed to. Cascade: their invites are
  // meaningless once the user is gone.
  invitedUser User? @relation("InviteRecipient", fields: [invitedUserId], references: [id], onDelete: Cascade)

  // Back-relation for the notification that carries this invite's actions.
  // Cascade lives on the Notification side; see the note there.
  notifications Notification[]

  // One invite row per person per project, enforced by the database rather than
  // by a service check that could race. Postgres treats NULLs as distinct, so
  // open code invites (invitedUserId = NULL) are unconstrained by this.
  //
  // Consequence, accepted deliberately: a declined invite occupies the slot, so
  // re-inviting *updates that row* back to PENDING rather than inserting a
  // second one. That loses the history of previous declines. At 2-3 members,
  // "was this person invited before?" is not a question worth a table for.
  @@unique([projectId, invitedUserId])
  @@index([projectId])
  // Drives "my pending invites".
  @@index([invitedUserId, status])
  @@map("project_invites")
}

model Task {
  id              String     @id @default(uuid()) @db.Uuid
  projectId       String     @map("project_id") @db.Uuid
  dailyPlanId     String?    @map("daily_plan_id") @db.Uuid
  title           String     @db.VarChar(255)
  status          TaskStatus @default(TODO)
  resourceQueries String[]   @map("resource_queries")
  rolloverCount   Int        @default(0) @map("rollover_count")
  createdAt       DateTime   @default(now()) @map("created_at")
  plannedFor      DateTime?  @db.Date

  /// Roadmap fields. All optional: tasks created by the existing brain-dump
  /// pipeline have none of these, and must keep working unchanged.
  milestoneId        String?          @map("milestone_id") @db.Uuid
  /// Null means unestimated. Progress weighting falls back to counting such a
  /// task as MEDIUM rather than excluding it, so an unestimated task still
  /// shows up as remaining work.
  effort             TaskEffort?
  priority           TaskPriority?
  /// How the user knows this task is finished. Plain text, one per line.
  acceptanceCriteria String?          @map("acceptance_criteria") @db.Text
  /// Tasks that must be DONE before this one can sensibly start. Self-relation
  /// through an explicit join table, since Prisma cannot express a many-to-many
  /// on the same model implicitly.
  dependsOn          TaskDependency[] @relation("DependentTask")
  dependedOnBy       TaskDependency[] @relation("PrerequisiteTask")
  /// Set when the status last became DONE, so weekly history and streaks can be
  /// computed without a separate event log. Cleared if a task is reopened.
  completedAt        DateTime?        @map("completed_at")

  /// Evidence that this task was actually done, and the verdict derived from
  /// it. Status is self-reported — anyone can tap "Done" — so completion is
  /// treated as a *claim* and recorded separately from what corroborates it.
  /// See TaskVerification.
  evidence     TaskEvidence[]
  verification TaskVerification?

  // Null means unclaimed. SetNull on delete so removing a member leaves their
  // tasks in the backlog rather than deleting the team's work.
  assigneeId   String? @map("assignee_id")
  assigneeName String? @map("assignee_name")

  project   Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  dailyPlan DailyPlan?    @relation(fields: [dailyPlanId], references: [id])
  resources Resource[]
  assignee  User?         @relation("TaskAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  comments  TaskComment[]
  // SetNull rather than Cascade: deleting a milestone must not delete the work
  // planned under it, only unlink it.
  milestone Milestone?    @relation(fields: [milestoneId], references: [id], onDelete: SetNull)

  @@index([assigneeId])
  @@index([milestoneId])
  // Weekly history and streaks scan completions by date.
  @@index([completedAt])
  @@map("tasks")
}

/// A dated chunk of a roadmap, grouping tasks between a start and a target.
model Milestone {
  id         String          @id @default(uuid()) @db.Uuid
  projectId  String          @map("project_id") @db.Uuid
  title      String          @db.VarChar(255)
  /// 1-based display order, so a roadmap reads top to bottom regardless of dates.
  position   Int
  status     MilestoneStatus @default(PLANNED)
  targetDate DateTime?       @map("target_date") @db.Date
  createdAt  DateTime        @default(now()) @map("created_at")
  updatedAt  DateTime        @updatedAt @map("updated_at")

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  tasks   Task[]

  @@unique([projectId, position])
  @@index([projectId, status])
  @@map("milestones")
}

/// An explicit prerequisite edge between two tasks.
///
/// A join table rather than an array of ids so the database enforces that both
/// ends exist and cascades cleanly when either task is deleted.
model TaskDependency {
  id             String @id @default(uuid()) @db.Uuid
  /// The task that is blocked.
  taskId         String @map("task_id") @db.Uuid
  /// The task that must finish first.
  prerequisiteId String @map("prerequisite_id") @db.Uuid

  task         Task @relation("DependentTask", fields: [taskId], references: [id], onDelete: Cascade)
  prerequisite Task @relation("PrerequisiteTask", fields: [prerequisiteId], references: [id], onDelete: Cascade)

  @@unique([taskId, prerequisiteId])
  @@index([prerequisiteId])
  @@map("task_dependencies")
}

model TaskComment {
  id         String   @id @default(uuid()) @db.Uuid
  taskId     String   @map("task_id") @db.Uuid
  authorId   String   @map("author_id")
  // Snapshot, same reasoning as the invite and assignee names: a comment row
  // reads on its own, and the byline stays what it was when written.
  authorName String   @map("author_name")
  body       String   @db.Text
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  task   Task @relation(fields: [taskId], references: [id], onDelete: Cascade)
  author User @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@index([taskId, createdAt])
  @@map("task_comments")
}

model Resource {
  id        String   @id @default(uuid()) @db.Uuid
  projectId String   @map("project_id") @db.Uuid
  taskId    String?  @map("task_id") @db.Uuid
  title     String   @db.VarChar(255)
  url       String   @db.Text
  type      String?  @db.VarChar(50)
  summary   String?  @db.Text
  createdAt DateTime @default(now()) @map("created_at")

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  task    Task?   @relation(fields: [taskId], references: [id], onDelete: SetNull)

  @@map("resources")
}

/// An evidence-informed product discovery report for a project.
///
/// Versioned rather than mutated: regenerating inserts version + 1 and leaves
/// earlier rows intact, so an APPROVED report can never be silently destroyed.
model ResearchReport {
  id        String               @id @default(uuid()) @db.Uuid
  projectId String               @map("project_id") @db.Uuid
  /// 1-based, per project. Unique with projectId.
  version   Int
  status    ResearchReportStatus @default(PENDING)

  /// The report body, shaped by the Zod schema in research.schema.ts. Stored as
  /// JSON because the section set is prompt-defined and will evolve; pinning it
  /// to columns would mean a migration per wording change.
  sections     Json?
  /// Retrieved sources: [{ title, url, retrievedAt }]. Kept separate from
  /// sections so citations can be validated and rendered independently.
  sources      Json?
  /// Citation-verification metrics (VerificationMetrics in entailment.schema.ts):
  /// how many cited claims were checked against their source excerpt and how
  /// many were demoted. Stored rather than recomputed so a later change to the
  /// checking logic cannot rewrite the record of an older report. Null on rows
  /// generated before verification existed, which is distinct from `ran: false`.
  verification Json?

  /// When the underlying web research ran — a report's claims age.
  researchedAt    DateTime? @map("researched_at")
  /// Which model produced this version, for reproducibility.
  model           String?   @db.VarChar(100)
  /// Populated only when status is FAILED.
  error           String?   @db.Text
  /// Why the user rejected this version, when they gave a reason. Fed into the
  /// next version's prompt as stated feedback, so rejecting is productive
  /// rather than only bookkeeping.
  rejectionReason String?   @map("rejection_reason") @db.Text

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, version])
  @@index([projectId, status])
  @@map("research_reports")
}

model ProjectEvent {
  id        String        @id @default(uuid()) @db.Uuid
  projectId String        @map("project_id") @db.Uuid
  stage     PipelineStage
  message   String?       @db.Text
  createdAt DateTime      @default(now()) @map("created_at")

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@map("project_events")
}

model DailyPlan {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Text
  planDate  DateTime @map("plan_date") @db.Date
  summary   String?  @db.Text
  createdAt DateTime @default(now()) @map("created_at")

  tasks Task[]
  user  User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, planDate])
  @@map("daily_plans")
}

/// How a GitHub repository is linked to a project.
///
/// Read-only by design: BLISP observes a repository, it never writes to one.
/// The token is the viewer's, stored encrypted, and is only ever used for GET
/// requests against the repositories the user explicitly linked.
model ProjectRepository {
  id        String @id @default(uuid()) @db.Uuid
  projectId String @map("project_id") @db.Uuid

  /// "owner/name" exactly as GitHub spells it, for display and API calls.
  owner String @db.VarChar(100)
  name  String @db.VarChar(100)
  /// GitHub's numeric id. Kept because a repository can be renamed, and the
  /// owner/name pair is therefore not a stable identity.
  githubId     BigInt  @map("github_id")
  defaultBranch String @default("main") @map("default_branch") @db.VarChar(100)
  isPrivate    Boolean @default(false) @map("is_private")

  /// Encrypted PAT or OAuth token used to read this repository. Nullable so a
  /// public repository can be polled unauthenticated if no token is supplied.
  /// Never returned by any endpoint.
  accessToken String? @map("access_token") @db.Text

  /// Watermark for incremental syncing: only commits after this are fetched,
  /// so a re-sync costs one page rather than the whole history.
  lastSyncedAt  DateTime? @map("last_synced_at")
  /// Why the last sync failed, for showing an honest state in the UI instead
  /// of a silently empty feed. Null when the last sync succeeded.
  lastSyncError String?   @map("last_sync_error") @db.Text

  linkedById String   @map("linked_by_id")
  linkedAt   DateTime @default(now()) @map("linked_at")

  project  Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  linkedBy User           @relation(fields: [linkedById], references: [id])
  evidence TaskEvidence[]

  /// One link per repository per project; re-linking updates in place.
  @@unique([projectId, githubId])
  @@index([projectId])
  @@map("project_repositories")
}

/// Where a piece of evidence came from.
enum EvidenceSource {
  /// Discovered automatically by matching a commit message to a task.
  COMMIT
  /// A pull request that referenced the task.
  PULL_REQUEST
  /// A GitHub issue closed with a reference to the task.
  ISSUE
  /// Attached by a human when automatic matching missed it. Still evidence,
  /// but weaker: a person chose it, so it is marked as such in the UI rather
  /// than being passed off as independently observed.
  MANUAL
}

/// One observed artifact that may corroborate a task's completion.
///
/// Deliberately append-only and never edited by the user: this table is the
/// record of what was *found*, separate from any judgement about it. A row
/// here does not by itself mean a task is done — TaskVerification holds that
/// conclusion, and the same commit can support a task that was later reopened.
model TaskEvidence {
  id     String         @id @default(uuid()) @db.Uuid
  taskId String         @map("task_id") @db.Uuid
  source EvidenceSource

  /// Commit SHA, PR number or issue number, as text so all three fit.
  externalId String @map("external_id") @db.VarChar(255)
  /// Commit subject or PR/issue title, stored so the UI need not re-fetch.
  title      String @db.Text
  url        String @db.Text
  /// GitHub login of the author, for attribution in a team project.
  authorLogin String? @map("author_login") @db.VarChar(100)
  /// When the work happened on GitHub, not when BLISP noticed it. This is what
  /// makes evidence checkable against a claimed completion time.
  occurredAt  DateTime @map("occurred_at")

  /// Why this was matched to the task, in plain language, e.g.
  /// 'commit message contains "BLISP-4f2a"'. Shown in the UI so a user can
  /// judge the match rather than trusting it.
  matchReason String @map("match_reason") @db.Text

  repositoryId String?   @map("repository_id") @db.Uuid
  /// Null for automatic matches; set when a person attached it.
  addedById    String?   @map("added_by_id")
  createdAt    DateTime  @default(now()) @map("created_at")

  task       Task               @relation(fields: [taskId], references: [id], onDelete: Cascade)
  repository ProjectRepository? @relation(fields: [repositoryId], references: [id], onDelete: SetNull)
  addedBy    User?              @relation(fields: [addedById], references: [id], onDelete: SetNull)

  /// The same artifact is recorded once per task. A commit legitimately
  /// supports several tasks, so this is not unique on externalId alone.
  @@unique([taskId, source, externalId])
  @@index([taskId])
  @@map("task_evidence")
}

/// The verdict on a completion claim.
///
/// Mirrors the discovery report's entailment verdicts, and for the same
/// reason: the honest answer to "is this done?" is often "we cannot tell", and
/// collapsing that into a boolean would misrepresent the evidence.
enum VerificationVerdict {
  /// Evidence was found that corroborates the claim.
  VERIFIED
  /// The task is marked done and a repository is linked, but nothing matching
  /// was found. NOT an accusation: non-code work and unconventional commit
  /// messages both land here legitimately.
  UNVERIFIED
  /// No repository is linked, so verification was never possible. Kept
  /// distinct from UNVERIFIED so a project without GitHub is not reported as
  /// failing verification.
  SELF_REPORTED
  /// Evidence exists but contradicts the claim — currently only when every
  /// piece of evidence predates the task being created.
  DISPUTED
}

/// The conclusion drawn about one task's completion claim.
///
/// Derived, never user-editable: there is no endpoint that sets `verdict`
/// directly. It is recomputed from TaskEvidence whenever evidence or status
/// changes, which is what makes it meaningful — a user can change their task
/// status freely, but cannot change what the evidence says about it.
model TaskVerification {
  id     String              @id @default(uuid()) @db.Uuid
  taskId String              @unique @map("task_id") @db.Uuid
  verdict VerificationVerdict

  /// How many evidence rows supported this verdict when it was computed.
  evidenceCount Int @default(0) @map("evidence_count")
  /// One sentence explaining the verdict in the user's terms, e.g.
  /// "2 commits reference this task". Written by the verifier, shown as-is.
  summary       String @db.Text

  /// The completion being judged. If a task is reopened and re-completed, the
  /// verdict is recomputed against the new claim rather than the old one.
  claimedAt  DateTime? @map("claimed_at")
  computedAt DateTime  @default(now()) @map("computed_at")

  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([verdict])
  @@map("task_verifications")
}
