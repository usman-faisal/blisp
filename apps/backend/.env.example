PORT=8000

POSTGRES_USER=danish
POSTGRES_PASSWORD=root
POSTGRES_DB=vonc

# When using docker in production machine, comment this var, docker compose will create this by itself
DATABASE_URL="postgresql://username:password@localhost:5432/vonc?schema=public"

CORS_ORIGINS=http://localhost:3000
BASE_DOMAIN=http://localhost:3000

JWT_SECRET=somesecretkey
JWT_EXPIRY=7d

# Clerk
CLERK_SECRET_KEY=
CLERK_PUBLISHABLE_KEY=
CLERK_WEBHOOK_SECRET=

GOOGLE_API_KEY=

# AI provider — "openrouter", "gemini" or "github". Required; the app refuses to
# boot without a valid value rather than failing later inside a queue job.
AI_PROVIDER=openrouter

# OpenRouter (openrouter.ai/keys). Unlike the others, the model id is REQUIRED —
# the catalogue is large and its free tier rotates, so there is no sensible
# default. Pick one that supports structured outputs: every call in this service
# is schema-constrained, and a model that only approximates JSON will fail
# validation on every brain dump.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=

# Gemini (aistudio.google.com/apikey). Model id is optional; it defaults to
# gemini-2.0-flash-lite.
GEMINI_API_KEY=
GEMINI_MODEL=

# GitHub Models. Kept for reference, but as of Aug 2026 the service appears to
# be retired: calls returned a "scheduled retirement brownout" error and the
# marketplace catalogue now 404s. Do not expect this branch to work.
GITHUB_TOKEN=
GITHUB_MODEL=

# Retries for transport failures (429, 5xx, timeouts) only — not schema
# mismatches. Defaults to 2. Set higher if a free tier rate-limits you.
AI_MAX_RETRIES=

# Web search for the research stage (tavily.com)
TAVILY_API_KEY=

# ── Voice-to-text ────────────────────────────────────────────────────────────
# Required for the microphone in the mobile app; without it
# POST /api/v1/transcription/audio returns 503 and the rest of the app works.
#
# Which provider serves it. "groq" (default) or "xai". Note Groq and Grok are
# different companies whose names differ by one letter:
#   groq → Groq Cloud, hosts OpenAI's Whisper, has a free tier
#   xai  → xAI's Grok, billed per audio hour, no free tier
STT_PROVIDER=groq

# Groq STT (console.groq.com/keys). Reuses GROQ_API_KEY above by default, so
# normally nothing here needs setting.
# Verified against console.groq.com/docs/speech-to-text on 2026-11-14:
#   POST https://api.groq.com/openai/v1/audio/transcriptions
# Free-tier limits for whisper-large-v3-turbo: 20 req/min, 2,000 req/day,
# 7,200 audio-seconds/hour, 28,800 audio-seconds/day. Any request under 10
# seconds is counted as 10, so short clips cost more than their real length.
#
# Optional: only to run STT on a separate key/quota from the research stage.
GROQ_STT_API_KEY=
# Optional. Defaults to whisper-large-v3-turbo. Use whisper-large-v3 for
# higher accuracy on accented or multilingual audio, at roughly half the speed.
# This is NOT GROQ_MODEL — that is the chat model and will 400 here.
GROQ_STT_MODEL=
# Optional overrides for the endpoint and request timeout (ms, default 60000).
GROQ_STT_BASE_URL=
GROQ_STT_TIMEOUT_MS=

# xAI STT — only read when STT_PROVIDER=xai. Billed per hour of audio for REST
# and streaming; xAI documents no free tier, so check your account credits
# before demoing. Verified against docs.x.ai on 2026-11-10.
XAI_API_KEY=
# Optional. Defaults to grok-voice-transcribe-2.0.
XAI_STT_MODEL=
# Optional overrides for the endpoint and request timeout (ms, default 60000).
XAI_API_BASE_URL=
XAI_STT_TIMEOUT_MS=

EMAIL=voncaidev@gmail.com
EMAIL_PASSWORD=

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URL=http://localhost:8000/api/v1/auth/google-auth-redirect
GOOGLE_REDIRECT_URL_CLIENT_REACT=http://localhost:3000/dashboard

ENCRYPTION_KEY=test-key

REDIS_HOST=redis
REDIS_PORT=6379

RESET_DATABASE=false

ADMINER_PORT=8080

CLERK_WEBHOOK_SECRET=
CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=