---
import { Image } from 'astro:assets';
import homeScreenshot from '../assets/home.jpeg';
import Logo from "../assets/logo.png"
---

<header class="sticky top-0 z-50 w-full backdrop-blur-md bg-core-background/80 border-b border-semantic-border/30">
    <nav class="w-full max-w-6xl mx-auto px-6 py-4 flex items-center justify-between">
        <a href="/" class="font-heading text-2xl font-bold tracking-tight text-core-text-primary flex items-center">
            <Image class="w-16" src={Logo} alt="Blisp logo" />
            <span>blisp</span>
        </a>

        <div class="hidden md:flex items-center gap-8">
            <a href="#how-it-works" class="text-sm font-medium text-core-text-secondary hover:text-core-text-primary transition-colors">How it works</a>
            <a href="#features" class="text-sm font-medium text-core-text-secondary hover:text-core-text-primary transition-colors">Features</a>
            <a href="#pricing" class="text-sm font-medium text-core-text-secondary hover:text-core-text-primary transition-colors">Pricing</a>
            <a href="#faq" class="text-sm font-medium text-core-text-secondary hover:text-core-text-primary transition-colors">FAQ</a>
        </div>

        <div class="flex items-center gap-4">
            <a href="#waitlist-final" class="text-sm font-semibold bg-brand-ember text-white px-5 py-2.5 rounded-full hover:opacity-90 hover:shadow-lg hover:shadow-brand-ember/20 transition-all">Get early access</a>
        </div>
    </nav>
</header>

<section class="relative overflow-hidden min-h-[90vh] flex items-center">
    <!-- Background glow -->
    <div class="absolute inset-0 pointer-events-none" aria-hidden="true">
        <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[900px] h-[900px] rounded-full bg-gradient-to-br from-brand-ember-mist via-core-background to-brand-ember-mist opacity-70 blur-[120px]"></div>
        <div class="absolute top-20 right-20 w-72 h-72 rounded-full bg-brand-ember/5 blur-[80px]"></div>
        <div class="absolute bottom-20 left-10 w-56 h-56 rounded-full bg-brand-flax/5 blur-[60px]"></div>
    </div>

    <div class="relative w-full max-w-6xl mx-auto px-6 flex flex-col md:flex-row items-center justify-between gap-12 lg:gap-20">
        <!-- Left: Copy -->
        <div class="flex-1 text-center md:text-left z-10 flex flex-col items-center md:items-start">
            <!-- Tagline pill -->
            <div class="hero-animate-1 inline-flex items-center gap-2 px-4 py-2 rounded-full bg-brand-ember-mist border border-brand-ember/10 mb-8">
                <span class="relative flex h-2 w-2">
                    <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-brand-ember opacity-75"></span>
                    <span class="relative inline-flex rounded-full h-2 w-2 bg-brand-ember"></span>
                </span>
                <span class="text-sm font-medium text-brand-ember">Launching soon — join the waitlist</span>
            </div>

            <h1 class="hero-animate-2 font-heading text-5xl md:text-6xl lg:text-[4.5rem] leading-[1.08] tracking-tight text-core-text-primary">
                Wake up knowing<br />
                <span class="gradient-text">exactly what to build.</span>
            </h1>

            <p class="hero-animate-3 mt-4 text-lg md:text-xl text-core-text-secondary max-w-xl leading-loose text-balance">
                Never ask "what do I work on today?" again. Voice dump your ideas and wake up to a researched, ready-to-execute plan — automatically.
            </p>

            <!-- Waitlist form -->
            <form class="hero-animate-4 mt-10 w-full max-w-md" id="waitlist-hero-form">
                <div class="flex gap-2">
                    <input
                        type="email"
                        name="email"
                        placeholder="your@email.com"
                        required
                        class="flex-1 px-5 py-3.5 rounded-full bg-core-surface border border-semantic-border text-core-text-primary placeholder:text-core-text-disabled text-sm focus:outline-none focus:border-brand-ember focus:ring-2 focus:ring-brand-ember/10 transition-all"
                    />
                    <button type="submit" class="flex-shrink-0 px-6 py-3.5 rounded-full bg-brand-ember text-white font-semibold text-sm hover:opacity-90 hover:shadow-lg hover:shadow-brand-ember/20 transition-all active:scale-[0.97]">
                        Join waitlist
                    </button>
                </div>
                <p id="waitlist-hero-success" class="hidden mt-3 text-sm text-brand-sage font-medium">You're on the list! We'll be in touch.</p>
                <p class="mt-3 text-xs text-core-text-disabled">Free to start. No credit card required.</p>
            </form>

        </div>

        <!-- Right: Phone mockup -->
        <div class="relative flex-shrink-0 w-64 md:w-72 lg:w-80 group z-10 hero-phone">
            <div class="absolute -inset-8 bg-gradient-to-b from-brand-ember/15 via-brand-ember/5 to-transparent rounded-[3rem] blur-3xl pointer-events-none" aria-hidden="true"></div>

            <div class="relative rounded-[2.5rem] overflow-hidden shadow-2xl border-[6px] border-gray-900 bg-gray-900 -rotate-2 group-hover:rotate-0 group-hover:-translate-y-2 transition-all duration-500">
                <div class="rounded-[2rem] overflow-hidden bg-core-background border border-gray-800">
                    <Image src={homeScreenshot} alt="blisp app — voice-first brain dump interface" class="w-full object-cover" loading="eager" />
                </div>
            </div>

            <!-- Floating badge -->
            <div class="absolute -bottom-4 -left-6 bg-core-surface-elevated rounded-2xl px-4 py-3 shadow-card border border-semantic-border/30 animate-float">
                <div class="flex items-center gap-2">
                    <div class="w-8 h-8 rounded-full bg-brand-sage/10 flex items-center justify-center">
                        <svg class="w-4 h-4 text-brand-sage" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5"/></svg>
                    </div>
                    <div>
                        <p class="text-xs font-semibold text-core-text-primary">4 tasks ready</p>
                        <p class="text-[10px] text-core-text-disabled">for today</p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<script>
    document.getElementById('waitlist-hero-form')?.addEventListener('submit', async (e) => {
        e.preventDefault();
        const form = e.currentTarget as HTMLFormElement;
        const btn = form.querySelector('button') as HTMLButtonElement;
        const success = document.getElementById('waitlist-hero-success');
        const email = (form.querySelector('input[name="email"]') as HTMLInputElement)?.value;

        btn.disabled = true;
        btn.textContent = 'Joining...';
        btn.classList.add('opacity-70');

        try {
            const res = await fetch('/api/waitlist', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ email }),
            });

            if (res.ok) {
                btn.textContent = 'You\'re in!';
                success?.classList.remove('hidden');
            } else if (res.status === 409) {
                btn.textContent = 'Already joined!';
                if (success) {
                    success.textContent = 'You\'re already on the list — we\'ll be in touch!';
                    success.classList.remove('hidden');
                }
            } else if (res.status === 429) {
                btn.textContent = 'Too many attempts';
                btn.disabled = false;
                btn.classList.remove('opacity-70');
            } else {
                btn.textContent = 'Something went wrong';
                btn.disabled = false;
                btn.classList.remove('opacity-70');
            }
        } catch {
            btn.textContent = 'Something went wrong';
            btn.disabled = false;
            btn.classList.remove('opacity-70');
        }
    });
</script>
