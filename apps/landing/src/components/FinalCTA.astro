---
/* Final CTA + Footer */
---

<!-- Final CTA -->
<section id="waitlist-final" class="py-24 md:py-32 bg-core-surface relative overflow-hidden">
    <!-- Background effects -->
    <div class="absolute inset-0 pointer-events-none" aria-hidden="true">
        <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[700px] h-[700px] rounded-full bg-gradient-to-br from-brand-ember/8 via-transparent to-brand-flax/5 blur-[120px]"></div>
        <div class="absolute bottom-0 left-0 w-96 h-96 bg-brand-sage/3 rounded-full blur-[100px]"></div>
    </div>

    <div class="relative max-w-3xl mx-auto px-6 text-center reveal">
        <!-- Mic icon with pulse -->
        <div class="inline-flex items-center justify-center mb-8">
            <div class="relative">
                <div class="absolute inset-0 rounded-full bg-brand-ember/20 animate-pulse-ring"></div>
                <div class="relative w-16 h-16 rounded-full bg-brand-ember flex items-center justify-center shadow-lg shadow-brand-ember/20">
                    <svg class="w-7 h-7 text-white" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2a3 3 0 0 0-3 3v7a3 3 0 0 0 6 0V5a3 3 0 0 0-3-3Z"/><path d="M19 10v1a7 7 0 0 1-14 0v-1"/><line x1="12" x2="12" y1="19" y2="22"/></svg>
                </div>
            </div>
        </div>

        <h2 class="font-heading text-4xl md:text-6xl text-core-text-primary leading-[1.1] mb-6">
            Wake up tomorrow knowing<br />
            <span class="gradient-text">exactly what to build.</span>
        </h2>
        <p class="text-lg md:text-xl text-core-text-secondary max-w-xl mx-auto leading-relaxed mb-10">
            Blisp is launching soon. Drop your email and be the first to turn shower thoughts into shipped features.
        </p>
        <form class="flex flex-col sm:flex-row gap-3 max-w-md mx-auto" id="waitlist-final-form">
            <input
                type="email"
                name="email"
                placeholder="your@email.com"
                required
                class="flex-1 px-5 py-4 rounded-full bg-core-background border border-semantic-border text-core-text-primary placeholder:text-core-text-disabled text-sm focus:outline-none focus:border-brand-ember focus:ring-2 focus:ring-brand-ember/10 transition-all"
            />
            <button type="submit" class="flex-shrink-0 px-8 py-4 rounded-full bg-brand-ember text-white font-semibold text-base hover:opacity-90 hover:shadow-lg hover:shadow-brand-ember/20 transition-all active:scale-[0.97]">
                Join waitlist
            </button>
        </form>
        <p id="waitlist-final-success" class="hidden mt-4 text-sm text-brand-sage font-medium">You're on the list! We'll be in touch.</p>
        <p class="mt-4 text-xs text-core-text-disabled">No spam. Unsubscribe anytime.</p>
    </div>
</section>

<!-- Footer -->
<footer class="py-12 bg-core-text-primary">
    <div class="max-w-6xl mx-auto px-6">
        <div class="flex flex-col md:flex-row items-center justify-between gap-8">
            <div class="flex items-center gap-8">
                <a href="/" class="font-heading text-xl text-core-background">blisp</a>
                <div class="flex items-center gap-6">
                    <a href="#how-it-works" class="text-sm text-core-background/50 hover:text-core-background/80 transition-colors">How it works</a>
                    <a href="#features" class="text-sm text-core-background/50 hover:text-core-background/80 transition-colors">Features</a>
                    <a href="#pricing" class="text-sm text-core-background/50 hover:text-core-background/80 transition-colors">Pricing</a>
                </div>
            </div>
            <div class="flex items-center gap-6">
                <a href="#" class="text-sm text-core-background/50 hover:text-core-background/80 transition-colors">Privacy</a>
                <a href="#" class="text-sm text-core-background/50 hover:text-core-background/80 transition-colors">Terms</a>
                <a href="#" aria-label="GitHub" class="text-core-background/50 hover:text-core-background/80 transition-colors">
                    <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" viewBox="0 0 24 24" fill="currentColor"><path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"/></svg>
                </a>
                <a href="#" aria-label="Twitter / X" class="text-core-background/50 hover:text-core-background/80 transition-colors">
                    <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" viewBox="0 0 24 24" fill="currentColor"><path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/></svg>
                </a>
            </div>
        </div>
        <div class="mt-8 pt-8 border-t border-core-background/10 text-center">
            <p class="text-sm text-core-background/30">&copy; 2025 Blisp. All rights reserved.</p>
        </div>
    </div>
</footer>

<script>
    document.getElementById('waitlist-final-form')?.addEventListener('submit', async (e) => {
        e.preventDefault();
        const form = e.currentTarget as HTMLFormElement;
        const btn = form.querySelector('button') as HTMLButtonElement;
        const success = document.getElementById('waitlist-final-success');
        const email = (form.querySelector('input[name="email"]') as HTMLInputElement)?.value;

        btn.disabled = true;
        btn.textContent = 'Joining...';
        btn.classList.add('opacity-70');

        try {
            const res = await fetch('/api/waitlist', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ email }),
            });

            if (res.ok) {
                btn.textContent = 'You\'re in!';
                success?.classList.remove('hidden');
            } else if (res.status === 409) {
                btn.textContent = 'Already joined!';
                if (success) {
                    success.textContent = 'You\'re already on the list — we\'ll be in touch!';
                    success.classList.remove('hidden');
                }
            } else if (res.status === 429) {
                btn.textContent = 'Too many attempts';
                btn.disabled = false;
                btn.classList.remove('opacity-70');
            } else {
                btn.textContent = 'Something went wrong';
                btn.disabled = false;
                btn.classList.remove('opacity-70');
            }
        } catch {
            btn.textContent = 'Something went wrong';
            btn.disabled = false;
            btn.classList.remove('opacity-70');
        }
    });
</script>
