---
/* How It Works — 4-Step Pipeline */
---

<section id="how-it-works" class="py-24 md:py-32 bg-core-surface relative overflow-hidden">
    <!-- Subtle background pattern -->
    <div class="absolute inset-0 pointer-events-none" aria-hidden="true">
        <div class="absolute top-0 left-1/2 -translate-x-1/2 w-[600px] h-[600px] rounded-full bg-brand-ember/3 blur-[150px]"></div>
    </div>

    <div class="max-w-6xl mx-auto px-6 relative">
        <div class="max-w-3xl mb-20 reveal">
            <p class="text-xs font-semibold uppercase tracking-widest text-brand-ember mb-4">
                How it works
            </p>
            <h2 class="font-heading text-4xl md:text-5xl text-core-text-primary leading-[1.15]">
                From shower thought to <span class="gradient-text">shipped feature.</span>
            </h2>
            <p class="mt-5 text-lg text-core-text-secondary leading-relaxed max-w-2xl">
                Four automated stages. Zero planning overhead. You speak — blisp does the rest.
            </p>
        </div>

        <!-- Horizontal pipeline indicator (desktop) -->
        <!-- <div class="hidden md:flex items-center justify-between mb-12 reveal">
            <div class="flex items-center gap-3">
                <span class="flex items-center justify-center w-10 h-10 rounded-full bg-brand-ember text-white text-sm font-bold shadow-md shadow-brand-ember/20">1</span>
                <span class="text-sm font-semibold text-core-text-primary">Capture</span>
            </div>
            <div class="flex-1 mx-4 h-px bg-gradient-to-r from-brand-ember/40 via-brand-sage/30 to-brand-sage/40 relative">
                <div class="absolute top-1/2 left-1/4 w-2 h-2 rounded-full bg-brand-ember/40 -translate-y-1/2"></div>
                <div class="absolute top-1/2 left-1/2 w-2 h-2 rounded-full bg-brand-sage/40 -translate-y-1/2"></div>
                <div class="absolute top-1/2 left-3/4 w-2 h-2 rounded-full bg-brand-flax/40 -translate-y-1/2"></div>
            </div>
            <div class="flex items-center gap-3">
                <span class="flex items-center justify-center w-10 h-10 rounded-full bg-brand-sage text-white text-sm font-bold shadow-md shadow-brand-sage/20">2</span>
                <span class="text-sm font-semibold text-core-text-primary">Research</span>
            </div>
            <div class="flex-1 mx-4 h-px bg-gradient-to-r from-brand-sage/40 via-brand-flax/30 to-brand-flax/40"></div>
            <div class="flex items-center gap-3">
                <span class="flex items-center justify-center w-10 h-10 rounded-full bg-brand-flax text-white text-sm font-bold shadow-md shadow-brand-flax/20">3</span>
                <span class="text-sm font-semibold text-core-text-primary">Plan</span>
            </div>
            <div class="flex-1 mx-4 h-px bg-gradient-to-r from-brand-flax/40 via-semantic-info/30 to-semantic-info/40"></div>
            <div class="flex items-center gap-3">
                <span class="flex items-center justify-center w-10 h-10 rounded-full bg-semantic-info text-white text-sm font-bold shadow-md shadow-semantic-info/20">4</span>
                <span class="text-sm font-semibold text-core-text-primary">Execute</span>
            </div>
        </div> -->

        <div class="space-y-6 relative">
            <!-- Step 1 -->
            <div class="reveal group grid grid-cols-1 md:grid-cols-2 gap-0 rounded-3xl bg-core-background border border-semantic-border/30 overflow-hidden hover:shadow-card hover:border-brand-ember/20 transition-all duration-500">
                <div class="p-10 md:p-12 flex flex-col justify-center">
                    <div class="flex items-center gap-4 mb-6">
                        <span class="flex md:hidden items-center justify-center w-10 h-10 rounded-full bg-brand-ember text-white text-sm font-bold shadow-md shadow-brand-ember/20">1</span>
                        <span class="text-xs font-semibold uppercase tracking-widest text-brand-ember">Capture</span>
                    </div>
                    <h3 class="font-heading text-2xl md:text-3xl text-core-text-primary mb-4">Brain Dump</h3>
                    <p class="text-core-text-secondary leading-relaxed text-lg mb-6">
                        Hit record and let it flow — on the commute, walking the dog, wherever. No structure needed. Blisp transcribes, understands context, and extracts projects automatically.
                    </p>
                    <div class="flex items-center gap-4 text-sm">
                        <span class="flex items-center gap-2 text-core-text-disabled">
                            <svg class="w-4 h-4 text-brand-ember" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2a3 3 0 0 0-3 3v7a3 3 0 0 0 6 0V5a3 3 0 0 0-3-3Z"/><path d="M19 10v1a7 7 0 0 1-14 0v-1"/></svg>
                            Voice-first
                        </span>
                        <span class="flex items-center gap-2 text-core-text-disabled">
                            <svg class="w-4 h-4 text-brand-ember" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M13 2 3 14h9l-1 8 10-12h-9l1-8z"/></svg>
                            Instant extraction
                        </span>
                    </div>
                </div>
                <div class="relative bg-gradient-to-br from-brand-ember-mist/40 via-core-surface to-core-surface flex items-center justify-center min-h-[280px] md:min-h-0">
                    <!-- App screenshot placeholder -->
                    <div class="relative w-48 h-auto p-4">
                        <div class="rounded-2xl bg-core-background border border-semantic-border/40 aspect-[9/16] flex items-center justify-center">
                            <span class="text-core-text-disabled text-sm">Screenshot</span>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Step 2 -->
            <div class="reveal group grid grid-cols-1 md:grid-cols-2 gap-0 rounded-3xl bg-core-background border border-semantic-border/30 overflow-hidden hover:shadow-card hover:border-brand-sage/20 transition-all duration-500">
                <div class="order-2 md:order-1 relative bg-gradient-to-bl from-green-50/40 via-core-surface to-core-surface flex items-center justify-center min-h-[280px] md:min-h-0">
                    <!-- App screenshot placeholder -->
                    <div class="relative w-48 h-auto p-4">
                        <div class="rounded-2xl bg-core-background border border-semantic-border/40 aspect-[9/16] flex items-center justify-center">
                            <span class="text-core-text-disabled text-sm">Screenshot</span>
                        </div>
                    </div>
                </div>
                <div class="order-1 md:order-2 p-10 md:p-12 flex flex-col justify-center">
                    <div class="flex items-center gap-4 mb-6">
                        <span class="flex md:hidden items-center justify-center w-10 h-10 rounded-full bg-brand-sage text-white text-sm font-bold shadow-md shadow-brand-sage/20">2</span>
                        <span class="text-xs font-semibold uppercase tracking-widest text-brand-sage">Research</span>
                    </div>
                    <h3 class="font-heading text-2xl md:text-3xl text-core-text-primary mb-4">The Incubator</h3>
                    <p class="text-core-text-secondary leading-relaxed text-lg mb-6">
                        Blisp's AI agent searches the web for documentation, tutorials, GitHub repos, and architectural patterns matched to your exact tech stack. You sleep — it works.
                    </p>
                    <div class="flex items-center gap-4 text-sm">
                        <span class="flex items-center gap-2 text-core-text-disabled">
                            <svg class="w-4 h-4 text-brand-sage" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.3-4.3"/></svg>
                            Web search
                        </span>
                        <span class="flex items-center gap-2 text-core-text-disabled">
                            <svg class="w-4 h-4 text-brand-sage" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"/><path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"/></svg>
                            Curated resources
                        </span>
                    </div>
                </div>
            </div>

            <!-- Step 3 -->
            <div class="reveal group grid grid-cols-1 md:grid-cols-2 gap-0 rounded-3xl bg-core-background border border-semantic-border/30 overflow-hidden hover:shadow-card hover:border-brand-flax/20 transition-all duration-500">
                <div class="p-10 md:p-12 flex flex-col justify-center">
                    <div class="flex items-center gap-4 mb-6">
                        <span class="flex md:hidden items-center justify-center w-10 h-10 rounded-full bg-brand-flax text-white text-sm font-bold shadow-md shadow-brand-flax/20">3</span>
                        <span class="text-xs font-semibold uppercase tracking-widest text-brand-flax">Plan</span>
                    </div>
                    <h3 class="font-heading text-2xl md:text-3xl text-core-text-primary mb-4">Morning Briefing</h3>
                    <p class="text-core-text-secondary leading-relaxed text-lg mb-6">
                        Wake up to a 2-sentence summary and 2-3 bite-sized tasks tailored to your daily capacity. No overwhelm — just the next meaningful step, every morning.
                    </p>
                    <div class="flex items-center gap-4 text-sm">
                        <span class="flex items-center gap-2 text-core-text-disabled">
                            <svg class="w-4 h-4 text-brand-flax" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M8 2v4"/><path d="M16 2v4"/><rect width="18" height="18" x="3" y="4" rx="2"/><path d="M3 10h18"/></svg>
                            Daily cadence
                        </span>
                        <span class="flex items-center gap-2 text-core-text-disabled">
                            <svg class="w-4 h-4 text-brand-flax" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 20h9"/><path d="M16.5 3.5a2.121 2.121 0 0 1 3 3L7 19l-4 1 1-4L16.5 3.5z"/></svg>
                            Capacity-aware
                        </span>
                    </div>
                </div>
                <div class="relative bg-gradient-to-br from-yellow-50/40 via-core-surface to-core-surface flex items-center justify-center min-h-[280px] md:min-h-0">
                    <!-- App screenshot placeholder -->
                    <div class="relative w-48 h-auto p-4">
                        <div class="rounded-2xl bg-core-background border border-semantic-border/40 aspect-[9/16] flex items-center justify-center">
                            <span class="text-core-text-disabled text-sm">Screenshot</span>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Step 4 -->
            <div class="reveal group grid grid-cols-1 md:grid-cols-2 gap-0 rounded-3xl bg-core-background border border-semantic-border/30 overflow-hidden hover:shadow-card hover:border-semantic-info/20 transition-all duration-500">
                <div class="order-2 md:order-1 relative bg-gradient-to-bl from-blue-50/40 via-core-surface to-core-surface flex items-center justify-center min-h-[280px] md:min-h-0">
                    <!-- App screenshot placeholder -->
                    <div class="relative w-48 h-auto p-4">
                        <div class="rounded-2xl bg-core-background border border-semantic-border/40 aspect-[9/16] flex items-center justify-center">
                            <span class="text-core-text-disabled text-sm">Screenshot</span>
                        </div>
                    </div>
                </div>
                <div class="order-1 md:order-2 p-10 md:p-12 flex flex-col justify-center">
                    <div class="flex items-center gap-4 mb-6">
                        <span class="flex md:hidden items-center justify-center w-10 h-10 rounded-full bg-semantic-info text-white text-sm font-bold shadow-md shadow-semantic-info/20">4</span>
                        <span class="text-xs font-semibold uppercase tracking-widest text-semantic-info">Execute</span>
                    </div>
                    <h3 class="font-heading text-2xl md:text-3xl text-core-text-primary mb-4">Build & Iterate</h3>
                    <p class="text-core-text-secondary leading-relaxed text-lg mb-6">
                        Check off tasks, record a quick voice update, and let the AI rebalance tomorrow's plan. A flywheel that compounds — every single day.
                    </p>
                    <div class="flex items-center gap-4 text-sm">
                        <span class="flex items-center gap-2 text-core-text-disabled">
                            <svg class="w-4 h-4 text-semantic-info" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5"/></svg>
                            Track progress
                        </span>
                        <span class="flex items-center gap-2 text-core-text-disabled">
                            <svg class="w-4 h-4 text-semantic-info" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 7v6h-6"/><path d="M3 17a9 9 0 0 1 9-9 9 9 0 0 1 6 2.3l3 2.7"/></svg>
                            Auto-rollover
                        </span>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>
