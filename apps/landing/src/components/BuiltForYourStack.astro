---
import { Icon } from 'astro-icon/components';

const techStack = [
  { name: "React", icon: "simple-icons:react", color: "text-[#61DAFB]" },
  { name: "Node.js", icon: "simple-icons:nodedotjs", color: "text-[#339933]" },
  { name: "Python", icon: "simple-icons:python", color: "text-[#3776AB]" },
  { name: "TypeScript", icon: "simple-icons:typescript", color: "text-[#3178C6]" },
  { name: "PostgreSQL", icon: "simple-icons:postgresql", color: "text-[#4169E1]" },
  { name: "Docker", icon: "simple-icons:docker", color: "text-[#2496ED]" },
  { name: "AWS", icon: "simple-icons:amazonaws", color: "text-[#FF9900]" },
  { name: "NestJS", icon: "simple-icons:nestjs", color: "text-[#E0234E]" },
  { name: "Prisma", icon: "simple-icons:prisma", color: "text-[#2D3748]" },
];

const reverseStack = [
  { name: "Next.js", icon: "simple-icons:nextdotjs", color: "text-core-text-primary" },
  { name: "Go", icon: "simple-icons:go", color: "text-[#00ADD8]" },
  { name: "Rust", icon: "simple-icons:rust", color: "text-[#DEA584]" },
  { name: "Swift", icon: "simple-icons:swift", color: "text-[#F05138]" },
  { name: "Redis", icon: "simple-icons:redis", color: "text-[#DC382D]" },
  { name: "Kubernetes", icon: "simple-icons:kubernetes", color: "text-[#326CE5]" },
  { name: "GraphQL", icon: "simple-icons:graphql", color: "text-[#E10098]" },
  { name: "Drizzle", icon: "simple-icons:drizzle", color: "text-[#C5F74F]" },
];
---
<div class="flex gap-6 mb-6 overflow-hidden marquee-container">
    <div class="flex gap-6 animate-marquee whitespace-nowrap">
        {[...techStack, ...techStack].map((tech) => (
            <div class="flex-shrink-0 px-8 py-4 rounded-2xl bg-core-background border border-semantic-border/30 flex items-center gap-3 hover:border-brand-ember/20 hover:shadow-card transition-all duration-300">
                <Icon name={tech.icon} class={`w-7 h-7 ${tech.color}`} />
                <span class="text-sm font-medium text-core-text-primary">{tech.name}</span>
            </div>
        ))}
    </div>
</div>

<div class="flex gap-6 overflow-hidden marquee-container">
    <div class="flex gap-6 animate-marquee-reverse whitespace-nowrap">
        {[...reverseStack, ...reverseStack].map((tech) => (
            <div class="flex-shrink-0 px-8 py-4 rounded-2xl bg-core-background border border-semantic-border/30 flex items-center gap-3 hover:border-brand-ember/20 hover:shadow-card transition-all duration-300">
                <Icon name={tech.icon} class={`w-7 h-7 ${tech.color}`} />
                <span class="text-sm font-medium text-core-text-primary">{tech.name}</span>
            </div>
        ))}
    </div>
</div>