---
/* Pricing Section */
---

<section id="pricing" class="py-24 md:py-32 bg-core-surface relative">
    <div class="max-w-5xl mx-auto px-6">
        <div class="text-center max-w-3xl mx-auto mb-16">
            <p class="text-xs font-semibold uppercase tracking-widest text-brand-ember mb-4">
                Pricing
            </p>
            <h2 class="font-heading text-4xl md:text-5xl text-core-text-primary leading-[1.15]">
                Start free. <span class="text-core-text-disabled">Scale when ready.</span>
            </h2>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-6 max-w-4xl mx-auto">
            <!-- Free Tier -->
            <div class="rounded-3xl bg-core-background border border-semantic-border/30 p-10">
                <div class="mb-8">
                    <h3 class="font-heading text-2xl text-core-text-primary mb-1">Free</h3>
                    <p class="text-core-text-secondary text-sm">For getting started</p>
                </div>
                <div class="flex items-baseline gap-1 mb-8">
                    <span class="font-heading text-5xl text-core-text-primary">$0</span>
                    <span class="text-core-text-disabled text-sm">/month</span>
                </div>
                <a href="#" class="block w-full text-center py-3.5 rounded-full border-2 border-semantic-border text-core-text-primary font-semibold hover:bg-core-surface transition-colors">
                    Get started
                </a>
                <div class="mt-8 pt-8 border-t border-semantic-border/30 space-y-4">
                    <div class="flex items-start gap-3">
                        <svg class="w-5 h-5 text-brand-sage flex-shrink-0 mt-0.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5"/></svg>
                        <span class="text-core-text-secondary text-sm">5 brain dumps per month</span>
                    </div>
                    <div class="flex items-start gap-3">
                        <svg class="w-5 h-5 text-brand-sage flex-shrink-0 mt-0.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5"/></svg>
                        <span class="text-core-text-secondary text-sm">2 active projects</span>
                    </div>
                    <div class="flex items-start gap-3">
                        <svg class="w-5 h-5 text-brand-sage flex-shrink-0 mt-0.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5"/></svg>
                        <span class="text-core-text-secondary text-sm">Basic AI research</span>
                    </div>
                    <div class="flex items-start gap-3">
                        <svg class="w-5 h-5 text-brand-sage flex-shrink-0 mt-0.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5"/></svg>
                        <span class="text-core-text-secondary text-sm">Daily plan generation</span>
                    </div>
                    <div class="flex items-start gap-3">
                        <svg class="w-5 h-5 text-brand-sage flex-shrink-0 mt-0.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5"/></svg>
                        <span class="text-core-text-secondary text-sm">Voice capture & transcription</span>
                    </div>
                </div>
            </div>

            <!-- Pro Tier -->
            <div class="relative rounded-3xl border-2 border-brand-ember p-10 bg-core-background">
                <div class="absolute -top-3 left-1/2 -translate-x-1/2 px-4 py-1 rounded-full bg-brand-ember text-white text-xs font-bold uppercase tracking-wider">
                    Most Popular
                </div>
                <div class="mb-8">
                    <h3 class="font-heading text-2xl text-core-text-primary mb-1">Pro</h3>
                    <p class="text-core-text-secondary text-sm">For serious builders</p>
                </div>
                <div class="flex items-baseline gap-1 mb-8">
                    <span class="font-heading text-5xl text-core-text-primary">$9</span>
                    <span class="text-core-text-disabled text-sm">/month</span>
                </div>
                <a href="#" class="block w-full text-center py-3.5 rounded-full bg-brand-ember text-white font-semibold hover:opacity-90 hover:shadow-lg hover:shadow-brand-ember/20 transition-all">
                    Start free trial
                </a>
                <div class="mt-8 pt-8 border-t border-semantic-border/30 space-y-4">
                    <div class="flex items-start gap-3">
                        <svg class="w-5 h-5 text-brand-ember flex-shrink-0 mt-0.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5"/></svg>
                        <span class="text-core-text-secondary text-sm">Unlimited brain dumps</span>
                    </div>
                    <div class="flex items-start gap-3">
                        <svg class="w-5 h-5 text-brand-ember flex-shrink-0 mt-0.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5"/></svg>
                        <span class="text-core-text-secondary text-sm">Unlimited active projects</span>
                    </div>
                    <div class="flex items-start gap-3">
                        <svg class="w-5 h-5 text-brand-ember flex-shrink-0 mt-0.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5"/></svg>
                        <span class="text-core-text-secondary text-sm">Advanced agentic research</span>
                    </div>
                    <div class="flex items-start gap-3">
                        <svg class="w-5 h-5 text-brand-ember flex-shrink-0 mt-0.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5"/></svg>
                        <span class="text-core-text-secondary text-sm">Priority resource fetching</span>
                    </div>
                    <div class="flex items-start gap-3">
                        <svg class="w-5 h-5 text-brand-ember flex-shrink-0 mt-0.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5"/></svg>
                        <span class="text-core-text-secondary text-sm">Dynamic rollover & smart scheduling</span>
                    </div>
                    <div class="flex items-start gap-3">
                        <svg class="w-5 h-5 text-brand-ember flex-shrink-0 mt-0.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5"/></svg>
                        <span class="text-core-text-secondary text-sm">Export your data anytime</span>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>
