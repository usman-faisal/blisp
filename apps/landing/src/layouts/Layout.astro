---
import "../styles/global.css";
import SEO from "../components/SEO.astro";
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<link rel="icon" type="image/svg+xml" href="/logo.png" />
		<link rel="icon" href="/logo.png" />
		<meta name="generator" content={Astro.generator} />
		<!-- Fonts -->
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=DM+Serif+Display&family=Instrument+Sans:wght@400;500;600;700&display=swap"
			rel="stylesheet"
		/>

		<!-- SEO -->
		<SEO />

		<script type="application/ld+json">
			{
				"@context": "https://schema.org",
				"@type": "SoftwareApplication",
				"name": "Blisp",
				"description": "Voice dump your ideas and wake up to a researched, ready-to-execute daily plan for your side projects.",
				"applicationCategory": "ProductivityApplication",
				"operatingSystem": "Web, iOS, Android",
				"offers": {
					"@type": "Offer",
					"price": "0",
					"priceCurrency": "USD"
				}
			}
		</script>
	</head>
	<body
		class="bg-core-background text-core-text-primary font-text antialiased"
	>
		<slot />

		<!-- Scroll-reveal observer -->
		<script>
			const observer = new IntersectionObserver(
				(entries) => {
					entries.forEach((entry) => {
						if (entry.isIntersecting) {
							entry.target.classList.add("visible");
						}
					});
				},
				{ threshold: 0.1, rootMargin: "0px 0px -40px 0px" },
			);

			document
				.querySelectorAll(
					".reveal, .reveal-left, .reveal-right, .reveal-scale",
				)
				.forEach((el) => {
					observer.observe(el);
				});
		</script>
	</body>
</html>

<style>
	html,
	body {
		margin: 0;
		width: 100%;
		height: 100%;
	}
</style>
